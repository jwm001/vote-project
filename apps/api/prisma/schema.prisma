generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String   @default("")
  realName     String
  idNumber     String   @default("")
  idNumberHash String?  @unique
  idCardImages String   @default("[]")
  status       String   @default("PENDING_VERIFICATION")
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userVoteHistories UserVoteHistory[]
  invites     VoteInvite[]
  identityVerificationRef String?
  identityVerifiedAt      DateTime?
}

model Vote {
  id           String   @id @default(cuid())
  title        String
  description  String?
  creatorId    String
  allowMultiple Boolean @default(false)
  participationMode String @default("OPEN_LINK")
  durationMinutes Int?
  resultsPublicDuringVote Boolean @default(false)
  listedInHall Boolean @default(false)
  startAt      DateTime
  endAt        DateTime
  auditHash    String?
  auditRecordedAt DateTime?
  startedAt    DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  options      Option[]
  ballots      Ballot[]
  userVoteHistories UserVoteHistory[]
  invites      VoteInvite[]
}

model Option {
  id     String @id @default(cuid())
  voteId String
  vote   Vote   @relation(fields: [voteId], references: [id])
  text   String
  order  Int
  isAbstain Boolean @default(false)
}

model Ballot {
  id             String   @id @default(cuid())
  voteId         String
  vote           Vote     @relation(fields: [voteId], references: [id])
  pseudonym      String
  optionIds      String
  submittedAt    DateTime @default(now())
  sequenceNumber Int

  @@unique([voteId, sequenceNumber])
}

model UserVoteHistory {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  voteId             String
  vote               Vote     @relation(fields: [voteId], references: [id])
  ballotSequenceNumber Int     @default(0)
  votedAt            DateTime @default(now())

  @@unique([userId, voteId])
}

model VoteInvite {
  id            String   @id @default(cuid())
  voteId        String
  vote          Vote     @relation(fields: [voteId], references: [id])
  inviteeUserId String?
  invitee       User?    @relation(fields: [inviteeUserId], references: [id])
  token         String?  @unique
  status        String   @default("INVITED")
  acceptedAt    DateTime?
  removedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([voteId, inviteeUserId])
  @@index([voteId])
}
