DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
ENCRYPTION_KEY="replace-with-a-32-byte-random-string"
# 一旦用于生产环境就不要再更换，否则历史用户的 idNumberHash 将无法与新注册用户去重。
ID_HASH_SECRET="replace-with-a-long-random-string"

# 实名核验：mock（本地开发）或 http（生产）
IDENTITY_PROVIDER="mock"
# mock 模式下允许通过的身份证号，逗号分隔
MOCK_ID_NUMBERS="110101199001011234"

# 跨域来源，逗号分隔；同域部署（Web 与 API 同一个域名）不需要设置
# CORS_ORIGIN="https://vote.example.com"

# 生产环境：
# IDENTITY_PROVIDER="http"
# IDENTITY_API_URL=""
# IDENTITY_API_KEY=""
